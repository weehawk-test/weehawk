NODE_ENV=development
INSTANCE_MODE=cloud

PORT=8080
CORS_ORIGIN=http://localhost:3000
WEBFRONTEND_BASE_URL=http://localhost:3000

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=weehawk
DB_SYNCHRONIZE=true
DB_DROP_SCHEMA=false

WEEHAWK_ENCRYPTION_KEY=your_encryption_key_here
WEEHAWK_API_KEY=your_strong_random_key_here

JWT_SECRET=super-long-random-jwt-secret
REFRESH_TOKEN_HASH_SECRET=another-super-long-random-secret-different-from-jwt
APP_AUTH_ALLOW_MULTIPLE_DEVICES=true

# Redis
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Google
google.clientId=
google.clientSecret=
google.callbackUrl=http://localhost:8080/login/oauth2/code/google

# Mail (Nest mailer)
MAIL_ENABLED=false
MAIL_LOG_BODY=true
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=


# apps/api/.env
API_PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000

WEEHAWK_ALLOW_PRIVATE_REMOTE_SSH_HOSTS=false