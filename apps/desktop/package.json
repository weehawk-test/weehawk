{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "main": "dist/main.js",
  "description": "Weehawk Desktop",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron --require tsx/cjs src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:icons": "node scripts/generate-icons.mjs",
    "prepare:resources": "tsx src/prepare-resources.ts",
    "package": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build:icons && pnpm -C ../.. --filter api build && pnpm -C ../.. --filter web build && pnpm prepare:resources && pnpm build && electron-builder --config electron-builder.json --win --x64"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "wait-on": "^9.0.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.7",
    "@types/wait-on": "^5.3.4",
    "cross-env": "^7.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  }
}
