{
  "appId": "com.weehawk.desktop",
  "productName": "Weehawk",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "assets/**",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".dist-resources",
      "to": "app-resources"
    }
  ],
  "asar": true,
  "win": {
    "icon": "assets/icon.ico",
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis"
      }
    ]
  }
}
