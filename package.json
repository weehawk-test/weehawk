{
  "name": "weehawk",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:cron-worker": "pnpm --filter cron-worker dev",
    "dev:provision-worker": "pnpm --filter provision-worker dev",
    "devcontainer": "pnpm -r --parallel devcontainer",
    "devcontainer:cron-worker": "pnpm --filter cron-worker devcontainer",
    "devcontainer:provision-worker": "pnpm --filter provision-worker devcontainer"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0"
  },
  "dependencies": {
    "framer-motion": "^12.38.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "path-to-regexp": "^8.4.0"
    }
  }
}