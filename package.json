{
  "name": "weehawk",
  "private": true,
  "scripts": {
    "build": "pnpm --filter api build && pnpm --filter web build",
    "test": "pnpm --filter api run test:ci",
    "typecheck": "pnpm --filter api exec tsc --noEmit -p tsconfig.build.json && pnpm --filter web exec tsc --noEmit",
    "dev": "pnpm -r --parallel dev",
    "dev:cron-worker": "pnpm --filter cron-worker dev",
    "dev:provision-worker": "pnpm --filter provision-worker dev",
    "devcontainer": "pnpm -r --parallel devcontainer",
    "devcontainer:cron-worker": "pnpm --filter cron-worker devcontainer",
    "devcontainer:provision-worker": "pnpm --filter provision-worker devcontainer",
    "reset-mypassword": "pnpm --filter api run reset-mypassword",
    "reset-mypassword:dev": "pnpm --filter api run reset-mypassword:dev"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0"
  },
  "dependencies": {
    "framer-motion": "^12.38.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "path-to-regexp": "^8.4.0",
      "protobufjs": "^7.5.5",
      "liquidjs": "^10.25.7",
      "fast-xml-builder": "^1.1.7",
      "fast-xml-parser": "^5.7.0",
      "fast-uri": "^3.1.2",
      "postcss": "^8.5.10",
      "uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "bcrypt",
      "better-sqlite3",
      "cpu-features",
      "protobufjs",
      "sharp",
      "ssh2",
      "unrs-resolver"
    ]
  }
}