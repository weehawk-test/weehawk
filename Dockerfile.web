# ───────────── building stage ─────────────
FROM node:20-alpine AS builder

ARG PNPM_VERSION=10.15.1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apk add --no-cache python3 make g++ libc6-compat

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=__WEEHAWK_RUNTIME_API_URL__
ARG NEXT_PUBLIC_INSTANCE_MODE=__WEEHAWK_RUNTIME_INSTANCE_MODE__
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_INSTANCE_MODE=$NEXT_PUBLIC_INSTANCE_MODE
ENV NEXT_TELEMETRY_DISABLED=1

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/cron-worker/package.json ./apps/cron-worker/
COPY apps/provision-worker/package.json ./apps/provision-worker/

RUN pnpm install --frozen-lockfile --filter web...

COPY apps/web ./apps/web

RUN pnpm --filter web run build

ENV CI=true
RUN pnpm prune --prod

# ───────────── runtime stage ─────────────
# Use Next "standalone" output (next.config.ts) — no node_modules/.bin or npx in the image.
FROM node:20-alpine AS runtime

RUN apk add --no-cache libc6-compat

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY docker/web/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && chown appuser:appgroup /entrypoint.sh

COPY --from=builder --chown=appuser:appgroup /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=appuser:appgroup /app/apps/web/.next/standalone ./
COPY --from=builder --chown=appuser:appgroup /app/apps/web/.next/static ./apps/web/.next/static

USER appuser

EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "apps/web/server.js"]
