# ───────────── build & deploy bundle ─────────────
FROM node:20-alpine AS builder

# pnpm 11+ requires Node.js ≥22.13; pin to 10.x for node:20 images.
# Suppresses interactive "Do you want to continue?" when Corepack fetches pnpm.
ARG PNPM_VERSION=10.15.1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apk add --no-cache python3 make g++ libc6-compat

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/cron-worker/package.json ./apps/cron-worker/
COPY apps/provision-worker/package.json ./apps/provision-worker/

RUN pnpm install --frozen-lockfile --filter api...

COPY apps/api ./apps/api

RUN pnpm --filter api run build

RUN mkdir -p /prod \
  && pnpm --filter api deploy --legacy --prod /prod/app

# ───────────── runtime ─────────────
FROM node:20-alpine AS runtime

ARG PNPM_VERSION=10.15.1

# bash + pnpm so admin scripts (e.g. `pnpm run reset-mypassword`) are usable via `docker exec`.
# Install pnpm via `npm i -g` (system-wide /usr/local/bin) instead of Corepack, so it works
# for non-root users without re-downloading "latest" into ~/.cache/node/corepack at runtime.
RUN apk add --no-cache libc6-compat openssl ca-certificates bash \
  && npm install -g pnpm@${PNPM_VERSION} \
  && npm cache clean --force

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /prod/app ./

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
  && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8080

CMD ["node", "dist/main.js"]
